# Copie para .env (uso local). No GitHub, cadastre as mesmas 3 variáveis em Settings > Secrets and variables > Actions > Variables.
# Estas duas são PÚBLICAS por natureza (a segurança está nas regras RLS do banco):
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
# URL final do site (sem barra no fim). Usada nos metadados de compartilhamento. Preencha após publicar.
VITE_SITE_URL=https://SEU-USUARIO.github.io/lista-lua-de-mel
# NUNCA coloque aqui a service_role key, tokens do provedor Pix ou senhas.
