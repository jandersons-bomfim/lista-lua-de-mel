# Segredos das Edge Functions (Pix dinâmico). Configure com:
#   supabase secrets set --env-file supabase/functions/.env
# Este arquivo NUNCA deve ir para o repositório com valores reais.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PIX_PAYER_EMAIL=email-do-casal@exemplo.com
PIX_CHARGE_MINUTES=1440
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já são injetados automaticamente pelo Supabase nas Edge Functions.
